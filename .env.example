# Required: create a DashScope API key at https://bailian.console.aliyun.com/
AI_DASHSCOPE_API_KEY=replace-with-your-dashscope-key
OPENAI_CHAT_MODEL=qwen3.7-flash

# Local Docker-only PostgreSQL settings.
POSTGRES_DB=aoding_agent
POSTGRES_USER=aoding
POSTGRES_PASSWORD=aoding-local

# Local Redis runs without a password, matching application-local.yml.
REDIS_PASSWORD=

# Optional SearchAPI.io fallback. Local SearXNG itself needs no API key.
SEARCH_API_KEY=
FRONTEND_PORT=18080
